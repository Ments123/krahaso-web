{
  "name": "krahaso",
  "version": "1.0.0",
  "private": true,
  "description": "Krahaso — cinematic grocery comparison brand site for Kosovo.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run verify:bundle",
    "preview": "vite preview",
    "test": "node --import tsx --test scripts/landing-page.test.tsx scripts/acquisition.test.ts && node --test scripts/verify-redesign.mjs",
    "verify:design": "node --test scripts/verify-redesign.mjs",
    "verify:bundle": "node scripts/check-bundle-budgets.mjs",
    "qa:browser": "node scripts/browser-audit.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
